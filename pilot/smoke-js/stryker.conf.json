{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Harness feasibility probe for the JS/TS stratum. Versions pinned: Stryker 10.1.1, cucumber-runner 10.1.1, @cucumber/cucumber 12.2.0.",
  "testRunner": "cucumber",
  "cucumber": {
    "features": ["features/**/*.feature"]
  },
  "mutate": ["src/**/*.js"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60
  },
  "timeoutMS": 30000,
  "concurrency": 2
}
