# Configurable allowlist for tools/guard-secrets.ps1
# Supported directives (one per line; lines starting with '#' are comments):
#   ticket-prefix:<PREFIX>   Exclude public technical/issue prefixes like GH-123 or RFC-2119
#   email:<ADDRESS>          Allow a verified public author/contact email
#   regex:<PATTERN>          Case-insensitive line allowlist for verified non-sensitive contexts
#
# Local machine-specific overrides can be placed in .secrets-allowlist.local (gitignored).

ticket-prefix:GH
ticket-prefix:PR
ticket-prefix:RQ
ticket-prefix:BDD
ticket-prefix:AST
ticket-prefix:ISO
ticket-prefix:RFC
ticket-prefix:IEEE
ticket-prefix:CVE
ticket-prefix:CWE
ticket-prefix:PEP
ticket-prefix:UTF
ticket-prefix:SHA

# --- Project allowlist additions (Lead, 2026-11-25) ---
# iSys/SBC public organisational contact shown in fetched venue pages.
email:sbc@sbc.org.br
# Our own gitignore/allowlist refer to the local override filenames by design.
regex:secrets-(denylist|allowlist)\.local
ticket-prefix:GATE

# --- Project allowlist additions (Lead, 2026-11-25, round 2) ---
# The author's own public contact, used in the Crossref polite-pool User-Agent.
email:correiadebrito.joao@gmail.com
# Public author contact printed on an openly hosted conference slide deck we cite.
email:nli@mdsol.com
# SPDX licence identifiers read as ticket-like ids (BSD-3-Clause, MPL-2.0, GPL-2.0...).
regex:\b(?:BSD|MPL|EPL|GPL|LGPL|CC0|Apache|MIT|CDDL|CC-BY)-[0-9]
# Maven system property -Dmaven.repo.local is not an internal hostname.
regex:-Dmaven\.repo\.local
# Public corporate domains belonging to cited venues/systems authors, not our employer.
regex:@mdsol\.com

# Narrow phrasings describing OTHER AUTHORS' proprietary software in our literature
# notes (Li et al. 2015 industrial Ruby project). Deliberately narrow: the bare word
# "proprietary" stays a finding outside these constructions.
regex:industrial \*?proprietary\*? (Ruby )?project
regex:one proprietary product
regex:proprietary single project
regex:single proprietary case study
# Vendored official iSys template assets (third-party; contain their own contact details).
regex:^% ?(sbc2025|sectsty|aas_macros)
regex:physics\.org

# --- Verified false positives -------------------------------------------------
# This firewall exists to keep identifying organisational references out of the
# repository. It should not flag the word "internal" in third-party public source
# paths, which is what happens below.
# data/metrics/static_indicators.csv records, per repository, the domain files it
# found; one public OSS project (yaronassa/cucumber-js-boilerplate) happens to have a
# mutator directory literally named "internal", so the VpnOrInternalHost rule matches
# "fieldMutators/internal/internal.ts". The pattern below is deliberately anchored to
# that exact public path so it cannot mask any genuine identifying reference.
regex:fieldMutators/internal/internal\.ts
