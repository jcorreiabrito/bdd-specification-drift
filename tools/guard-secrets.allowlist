# Configurable allowlist for tools/guard-secrets.ps1
# Supported directives (one per line; lines starting with '#' are comments):
#   ticket-prefix:<PREFIX>   Exclude public technical/issue prefixes like GH-123 or RFC-2119
#   email:<ADDRESS>          Allow a verified public author/contact email
#   regex:<PATTERN>          Case-insensitive line allowlist for verified non-sensitive contexts
#
# Local machine-specific overrides can be placed in .secrets-allowlist.local (gitignored).

ticket-prefix:GH
ticket-prefix:PR
ticket-prefix:RQ
ticket-prefix:BDD
ticket-prefix:AST
ticket-prefix:ISO
ticket-prefix:RFC
ticket-prefix:IEEE
ticket-prefix:CVE
ticket-prefix:CWE
ticket-prefix:PEP
ticket-prefix:UTF
ticket-prefix:SHA

# --- Project allowlist additions (Lead, 2026-11-25) ---
# iSys/SBC public organisational contact shown in fetched venue pages.
email:sbc@sbc.org.br
# Our own gitignore/allowlist refer to the local override filenames by design.
regex:secrets-(denylist|allowlist)\.local
ticket-prefix:GATE
